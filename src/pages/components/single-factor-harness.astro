---
import Base from "../../layouts/Base.astro";
import Bi from "../../components/Bi.astro";
import Shot from "../../components/Shot.astro";

const base = `${import.meta.env.BASE_URL.replace(/\/+$/, "")}/`;
---

<Base
  title="单因子检验体系 · Quant Research Portfolio"
  description="分组收益、RankIC、多空净值与稳定性标记：对一批因子做横向检验，作为其是否进入模型的依据"
>
  <section class="hero">
    <div class="hero-grid" aria-hidden="true"></div>
    <div class="wrap">
      <p class="eyebrow">
        <span data-i18n="zh">支撑组件 02 · 单因子检验</span>
        <span data-i18n="en">Component 02 · Single-factor testing</span>
      </p>
      <div class="hero-narrow">
        <Bi
          tag="h1"
          zh="单因子检验体系"
          en="Single-factor test harness"
        />
        <Bi
          tag="p"
          class="lede"
          zh="对一批因子做横向检验，作为其是否进入模型的依据。"
          en="Side-by-side testing across a batch of factors, used as the basis for admitting them to the model."
        />
      </div>
    </div>
  </section>

  <section class="band">
    <div class="wrap">
      <div class="rows">
        <div class="row">
          <span class="tag"><Bi tag="span" zh="产出" en="Output" /></span>
          <div class="body">
            <Bi
              tag="p"
              zh="分组收益、RankIC、多空净值与换手，以及历史对照近期的稳定性标记（large_change / invalidated / direction_reversal）。示例：WVAD 在 2005–2026 的 198 个有效期上 RankIC −0.0405、多空年化 −12.11%、Newey-West t 值 −9.19，判定为不通过。"
              en="Grouped returns, RankIC, long-short NAV and turnover, plus historical-versus-recent stability flags (large_change / invalidated / direction_reversal). Example: WVAD records RankIC −0.0405, −12.11% annualised long-short and a Newey-West t of −9.19 over 198 valid periods (2005–2026) and fails the screen."
            />
          </div>
        </div>
        <div class="row">
          <span class="tag"><Bi tag="span" zh="实验口径" en="Setup" /></span>
          <div class="body">
            <Bi
              tag="p"
              zh="信号取调仓日收盘价、收益自其后开始计，以避免同日前后视；多空净值按当期换手计提单边成本；每次检验的数值与图表均落盘，可独立复核。"
              en="Signals use the rebalance-day close and returns start strictly after it, so nothing is same-day look-ahead; long-short NAV charges one-way costs against that period's turnover; every run is written to disk as re-checkable data and charts."
            />
          </div>
        </div>
        <div class="row">
          <span class="tag"><Bi tag="span" zh="局限与边界" en="Limits" /></span>
          <div class="body">
            <Bi
              tag="p"
              zh="分组回测未施加 ST、停牌、涨跌停与流动性过滤；高换手因子在计入成本后会进一步减弱，因此检验结论仅作为筛选依据，不构成可交易结论。"
              en="The grouped backtest applies no ST, suspension, price-limit or liquidity filter; high-turnover factors weaken further once costs are charged, so a health check is a screen rather than a tradable conclusion."
            />
          </div>
        </div>
      </div>

      <figure>
        <Shot
          name="single_factor_wvad"
          altZh="WVAD 单因子体检：五分组年化收益没有单调性，多空净值（净）全程下行至 0.12"
          altEn="WVAD health check: no monotonicity across the five groups, and the net long-short NAV falls to 0.12"
        />
        <figcaption>
          <Bi
            tag="span"
            zh="体检实例：WVAD，2005-01 – 2026-07 的 198 个有效期，单边成本 10bp。a 五分组年化收益（净）——两侧深黑为多空组合实际交易的两端（Q1 / Q5），中间三组为参照；收益自 +5.3% 升至 +13.2% 再落到 −5.3%，单调性 −0.3，没有可用方向。b 多空组合净值（净）——期初 1.00，期末 0.12，198 期中仅 26.8% 为正；RankIC 均值 −0.0405，Newey-West t 值 −9.19。该因子判定为不通过。"
            en="One instance: WVAD, 198 valid periods from 2005-01 to 2026-07 at 10bp one-way cost. a — group annualised return (net): the dark bars are the two legs the long-short actually trades (Q1 and Q5) and the middle three are context; returns run +5.3% → +13.2% → −5.3% with a monotonicity of −0.3, so there is no usable direction. b — net long-short NAV starts at 1.00 and ends at 0.12, positive in only 26.8% of the 198 periods; mean RankIC is −0.0405 with a Newey-West t of −9.19. The factor fails the screen."
          />
        </figcaption>
      </figure>

      <div class="pager">
        <a href={`${base}components/factor-factory/`}>
          <span data-i18n="zh">← 组件 01 · 因子工厂与数据管道</span>
          <span data-i18n="en">← Component 01 · Factor factory</span>
        </a>
        <a href={base}>
          <span data-i18n="zh">返回首页 →</span>
          <span data-i18n="en">Home →</span>
        </a>
      </div>
    </div>
  </section>
</Base>
