---
import Base from "../../layouts/Base.astro";
import Bi from "../../components/Bi.astro";

const base = `${import.meta.env.BASE_URL.replace(/\/+$/, "")}/`;
---

<Base
  title="标签周期选择（生产模型） · Quant Research Portfolio"
  description="训练标签周期不必等于评估周期：将该思路应用于生产月频模型，各专家依代理标签选择自身周期"
>
  <section class="hero">
    <div class="hero-grid" aria-hidden="true"></div>
    <div class="wrap">
      <p class="eyebrow">
        <span data-i18n="zh">专题 · 生产月频模型</span>
        <span data-i18n="en">Study · production monthly model</span>
      </p>
      <div class="hero-narrow">
        <Bi
          tag="h1"
          zh="标签周期选择（生产模型）"
          en="Label-horizon selection (production model)"
        />
        <Bi
          tag="p"
          class="lede"
          zh="训练标签周期不必等于评估周期；本文将这一思路应用于生产模型。"
          en="The training label horizon need not equal the evaluation horizon; this note applies that idea to the production model."
        />
      </div>
    </div>
  </section>

  <section class="band">
    <div class="wrap">
      <div class="rows">
        <div class="row">
          <span class="tag"><Bi tag="span" zh="文献方法" en="Source paper" /></span>
          <div class="body">
            <Bi
              tag="p"
              zh="论文（Song et al., arXiv:2602.03395）指出最优训练标签周期往往不等于评估周期，且最优周期随信号被定价的速度与噪声累积而移动；其验证建立在分钟级数据上。"
              en="The paper (Song et al., arXiv:2602.03395) shows that the best training label horizon is often not the evaluation horizon, and that the optimum shifts with how fast the signal is priced in relative to noise accumulation. Its evidence comes from minute-level data."
            />
          </div>
        </div>
        <div class="row">
          <span class="tag"><Bi tag="span" zh="本文调整" en="Adaptation" /></span>
          <div class="body">
            <Bi
              tag="p"
              zh="不重复论文的分钟级实验，而是将该思路落实到生产月频 linear + XGBoost + GRU 模型：各专家依自身代理标签选择周期，并附加一条独立性去重规则。"
              en="Rather than repeating the paper's minute-level experiment, the idea is ported to the production monthly linear + XGBoost + GRU model: each expert selects its horizon from its own proxy labels, with a distinctness rule added."
            />
          </div>
        </div>
        <div class="row">
          <span class="tag"><Bi tag="span" zh="主要结论" en="Result" /></span>
          <div class="body">
            <Bi
              tag="p"
              zh="各专家以自身代理标签选择训练周期，评估周期保持不变；另设一条去重规则约束独立性，避免两个专家选中同一周期后相互抵消，使组合成为对同一信号的重复暴露。"
              en="Each expert selects its own training horizon from its own proxy labels while the evaluation horizon stays fixed, and a distinctness rule enforces independence so that two experts cannot converge on the same horizon and turn the blend into repeated exposure to one signal."
            />
          </div>
        </div>
        <div class="row">
          <span class="tag"><Bi tag="span" zh="实验口径" en="Setup" /></span>
          <div class="body">
            <Bi
              tag="p"
              zh="在生产月频 linear + XGBoost + GRU 模型上实现：按专家分别选周期，不改变评估与回测口径，也不改变调仓频率；结论与运行使用同一股票池、同一频率。"
              en="Implemented on the production monthly linear + XGBoost + GRU model: horizons are chosen per expert without changing the evaluation, the backtest convention or the rebalance frequency, and the conclusion holds for the same universe and frequency it was run on."
            />
          </div>
        </div>
        <div class="row">
          <span class="tag"><Bi tag="span" zh="局限与边界" en="Limits" /></span>
          <div class="body">
            <Bi
              tag="p"
              zh="这是对该思路的实现，而非对论文分钟级实验的复现；更换股票池、频率或标签定义均需重跑；周期选择本身基于同一段历史，存在选择偏差。"
              en="This is an implementation of the idea rather than a reproduction of the paper's minute-level experiment; a different universe, frequency or label definition requires its own run; and the horizons were selected on the same history they are judged on, so selection bias remains."
            />
          </div>
        </div>
      </div>

      <div class="pager">
        <a href={`${base}notes/top50-objective/`}>
          <span data-i18n="zh">← 头部 50 只目标函数</span>
          <span data-i18n="en">← Top-50 objective</span>
        </a>
        <a href={base}>
          <span data-i18n="zh">返回首页 →</span>
          <span data-i18n="en">Home →</span>
        </a>
      </div>
    </div>
  </section>
</Base>
