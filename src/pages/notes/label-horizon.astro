---
import Base from "../../layouts/Base.astro";
import Bi from "../../components/Bi.astro";
import Shot from "../../components/Shot.astro";

const base = `${import.meta.env.BASE_URL.replace(/\/+$/, "")}/`;
---

<Base
  title="标签周期选择（生产模型） · Quant Research Portfolio"
  description="训练标签周期不必等于评估周期：将该思路应用于生产月频模型，各专家依代理标签选择自身周期"
>
  <section class="hero">
    <div class="hero-grid" aria-hidden="true"></div>
    <div class="wrap">
      <p class="eyebrow">
        <span data-i18n="zh">专题 · 生产月频模型</span>
        <span data-i18n="en">Study · production monthly model</span>
      </p>
      <div class="hero-narrow">
        <Bi
          tag="h1"
          zh="标签周期选择（生产模型）"
          en="Label-horizon selection (production model)"
        />
        <Bi
          tag="p"
          class="lede"
          zh="训练标签周期不必等于评估周期；本文将这一思路应用于生产模型。"
          en="The training label horizon need not equal the evaluation horizon; this note applies that idea to the production model."
        />
      </div>
    </div>
  </section>

  <section class="band">
    <div class="wrap">
      <div class="rows">
        <div class="row">
          <span class="tag"><Bi tag="span" zh="文献方法" en="Source paper" /></span>
          <div class="body">
            <Bi
              tag="p"
              zh="论文（Song et al., arXiv:2602.03395）指出最优训练标签周期往往不等于评估周期，且最优周期随信号被定价的速度与噪声累积而移动；其验证建立在分钟级数据上。"
              en="The paper (Song et al., arXiv:2602.03395) shows that the best training label horizon is often not the evaluation horizon, and that the optimum shifts with how fast the signal is priced in relative to noise accumulation. Its evidence comes from minute-level data."
            />
          </div>
        </div>
        <div class="row">
          <span class="tag"><Bi tag="span" zh="本文调整" en="Adaptation" /></span>
          <div class="body">
            <Bi
              tag="p"
              zh="不重复论文的分钟级实验，而是将该思路落实到生产月频 linear + XGBoost + GRU 模型：各专家依自身代理标签选择周期，并附加一条独立性去重规则。"
              en="Rather than repeating the paper's minute-level experiment, the idea is ported to the production monthly linear + XGBoost + GRU model: each expert selects its horizon from its own proxy labels, with a distinctness rule added."
            />
          </div>
        </div>
        <div class="row">
          <span class="tag"><Bi tag="span" zh="主要结论" en="Result" /></span>
          <div class="body">
            <Bi
              tag="p"
              zh="选期规则按论文的乘法分解打分（评分 = 代理 IC × 对齐度），候选网格为 1/2/3/5/8/13/20 个交易日，评估周期固定 20 日。实际运行的 144 次选期全部落在 20 日，即与评估周期一致，独立性去重规则因此没有触发。相对 Linear 锚，模型 RankIC 均值提高 0.29pp（4.05%、IR 0.234），幅度有限。"
              en="The selection rule scores each candidate with the paper's multiplicative decomposition (score = proxy IC × alignment) over the grid 1/2/3/5/8/13/20 trading days, with the evaluation horizon fixed at 20. All 144 recorded selections land on 20 — the evaluation horizon itself — so the distinctness rule never triggers. Against the Linear anchor the model's mean RankIC rises by 0.29pp (4.05%, IR 0.234), a limited gain."
            />
          </div>
        </div>
        <div class="row">
          <span class="tag"><Bi tag="span" zh="实验口径" en="Setup" /></span>
          <div class="body">
            <Bi
              tag="p"
              zh="在生产月频 linear + XGBoost + GRU 模型上实现：按专家分别选周期，不改变评估与回测口径，也不改变调仓频率；结论与运行使用同一股票池、同一频率。"
              en="Implemented on the production monthly linear + XGBoost + GRU model: horizons are chosen per expert without changing the evaluation, the backtest convention or the rebalance frequency, and the conclusion holds for the same universe and frequency it was run on."
            />
          </div>
        </div>
        <div class="row">
          <span class="tag"><Bi tag="span" zh="局限与边界" en="Limits" /></span>
          <div class="body">
            <Bi
              tag="p"
              zh="这是对该思路的实现，而非对论文分钟级实验的复现；更换股票池、频率或标签定义均需重跑；周期选择基于同一段历史，存在选择偏差。另外，落盘的分候选评分无法还原「恒选 20 日」这一决策——网格内均值最高点是 Linear 与 XGBoost 的 20 日、GRU 的 13 日——选期环节的取舍需要补充记录才能复核。"
              en="This is an implementation of the idea rather than a reproduction of the paper's minute-level experiment; a different universe, frequency or label definition requires its own run; the horizons were selected on the same history they are judged on, so selection bias remains. The stored per-candidate scores also do not reproduce the “always 20” decision — within the grid the highest mean is 20 days for Linear and XGBoost but 13 days for GRU — so the selection step needs fuller logging before it can be audited."
            />
          </div>
        </div>
      </div>

      <figure>
        <Shot
          name="label_horizon"
          altZh="三个专家选中的标签周期（全部落在 20 日）与候选周期的平均评分"
          altEn="The label horizon chosen by each expert (all land on 20 days) and the mean score by candidate horizon"
        />
        <figcaption>
          <Bi
            tag="span"
            zh="选期结果，2018-03 – 2026-07 共 48 次选期、每位专家一次。a 选中的周期：纵轴为候选网格（1/2/3/5/8/13/20，分类轴），三个专家 48 次全部落在 20 日，没有任何一次选到更短的周期。b 候选周期的平均评分（评分 = 代理 IC × 对齐度，只计入被接受的候选；横轴为实际被打分的 14 个周期）：20 日在 Linear 与 XGBoost 上均值最高，GRU 的均值最高点是 13 日——按落盘评分重算不能还原「恒选 20 日」这一结果。"
            en="Selections from 2018-03 to 2026-07, 48 rounds with one choice per expert. a — the chosen horizon: the y-axis is the candidate grid (1/2/3/5/8/13/20, categorical) and all 48 selections land on 20 days, with no shorter horizon ever chosen. b — mean score by candidate horizon (score = proxy IC × alignment, accepted candidates only, across the 14 horizons actually scored): 20 days has the highest mean for Linear and XGBoost while GRU peaks at 13 days — so recomputing from the stored scores does not reproduce the “always 20” outcome."
          />
        </figcaption>
      </figure>

      <div class="pager">
        <a href={`${base}notes/top50-objective/`}>
          <span data-i18n="zh">← 头部 50 只目标函数</span>
          <span data-i18n="en">← Top-50 objective</span>
        </a>
        <a href={base}>
          <span data-i18n="zh">返回首页 →</span>
          <span data-i18n="en">Home →</span>
        </a>
      </div>
    </div>
  </section>
</Base>
